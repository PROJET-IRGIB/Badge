rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // This role comes from a Firebase Auth custom claim, never from a
    // Firestore field that a student could edit.
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    match /students/{studentUid} {
      allow get: if signedIn() && (request.auth.uid == studentUid || isAdmin());
      allow list: if isAdmin();
      // Creation, updates, and final matricule assignment go through trusted
      // server functions so the permanent identifier can be reserved uniquely.
      allow create, update, delete: if false;
    }

    match /applications/{applicationId} {
      allow get, list: if isAdmin()
        || (signedIn() && resource.data.studentUid == request.auth.uid);
      // Submission and the approve/reject decision are server-side actions.
      allow create, update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow get, list: if isAdmin()
        || (signedIn() && resource.data.studentUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /attendanceRecords/{recordId} {
      allow get, list: if isAdmin()
        || (signedIn() && resource.data.studentUid == request.auth.uid);
      // A trusted function validates the session QR and prevents duplicates.
      allow create, update, delete: if false;
    }

    match /attendanceSessions/{sessionId} {
      allow get: if signedIn() && resource.data.active == true;
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /catalog/{document=**} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /sites/{document=**} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /groups/{document=**} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Anything without an explicit rule is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
